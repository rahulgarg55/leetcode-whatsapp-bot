# ==============================================================================
# LeetCode WhatsApp Daily Bot Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Google Gemini is default and recommended)
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Claude / Anthropic API Key (if you set LLM_PROVIDER=claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=gemini

# Twilio WhatsApp Credentials
# Find these in your Twilio Console dashboard: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp Sender Number (Format: whatsapp:+<number>)
# Twilio WhatsApp Sandbox default: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Recipient WhatsApp Number (Format: whatsapp:+<country_code><phone_number>)
# Example for India: whatsapp:+917807221279
TO_WHATSAPP_NUMBER=whatsapp:+917807221279
